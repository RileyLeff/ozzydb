# Production environment variables
# Copy to .env.prod and fill in real values
# NEVER commit .env.prod to version control!

# Domains for Caddy HTTPS
API_DOMAIN=api.ozzydb.com
FRONTEND_DOMAIN=ozzydb.com

# Database
POSTGRES_USER=ozzy
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ozzy
DB_MAX_CONNECTIONS=10

# Server
BASE_URL=https://api.ozzydb.com

# GitHub OAuth (create at https://github.com/settings/developers)
# Enable "Device Flow" in the OAuth app settings
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# Registration allowlist (comma-separated GitHub usernames)
# Leave empty to allow all users
ALLOWED_LOGINS=rileyleff

# GitHub App (optional — enables private repo access via push)
# Create at https://github.com/settings/apps
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Secrets encryption (hex-encoded 32-byte key; required for project secrets)
# Generate with: openssl rand -hex 32
# SECRETS_ENCRYPTION_KEY=your_64_char_hex_string

# R2/S3 Storage (required)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=ozzy-registry
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_REGION=auto

# Global compute settings
COMPUTE_TIMEOUT_SECS=300
# COMPUTE_DEFAULT_PROVIDER=docker

# Docker compute provider (local container execution)
DOCKER_COMPUTE_ENABLED=true
DOCKER_COMPUTE_RUNTIME=runsc
DOCKER_COMPUTE_MEMORY_LIMIT=2g
DOCKER_COMPUTE_CPU_LIMIT=1

# Fly Machines compute provider (optional — enables remote compute)
# FLY_API_TOKEN=your_fly_api_token
# FLY_APP_NAME=ozzy-compute
# FLY_REGION=iad
# FLY_API_URL=https://api.machines.dev
# FLY_CPU_KIND=shared
# FLY_CPUS=1
# FLY_MEMORY_MB=256

# Rate limiting (concurrent job limits; 0 = unlimited)
# RATE_LIMIT_GLOBAL_MAX=20
# RATE_LIMIT_PER_USER_MAX=5

# CORS (comma-separated origins, or * for any)
CORS_ORIGINS=*

# Limits
MAX_UPLOAD_SIZE_BYTES=104857600

# Logging
RUST_LOG=info,ozzy_server=debug
