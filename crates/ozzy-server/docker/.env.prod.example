# Production environment variables
# Copy to .env.prod and fill in real values
# NEVER commit .env.prod to version control!

# Domain for Caddy HTTPS
DOMAIN=registry.ozzydb.dev

# Database
POSTGRES_USER=ozzy
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ozzy
DB_MAX_CONNECTIONS=20

# Server
BASE_URL=https://registry.ozzydb.dev

# GitHub OAuth (create at https://github.com/settings/developers)
# Set callback URL to: https://registry.ozzydb.dev/api/v1/auth/callback
GITHUB_CLIENT_ID=your_prod_client_id
GITHUB_CLIENT_SECRET=your_prod_client_secret

# Cloudflare R2 Storage
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=ozzy-registry
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_REGION=auto

# Limits
MAX_TAR_SIZE_BYTES=1073741824
MAX_UPLOAD_SIZE_BYTES=104857600

# Logging
RUST_LOG=info,ozzy_server=debug
