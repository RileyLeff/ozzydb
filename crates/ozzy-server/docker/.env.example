# Development environment variables
# Copy to .env and customize

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://ozzy:ozzy_dev_password@localhost:5432/ozzy

# Server
BIND_ADDRESS=0.0.0.0:3000
BASE_URL=http://localhost:3000

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_dev_client_id
GITHUB_CLIENT_SECRET=your_dev_client_secret

# MinIO (S3-compatible, matches docker-compose.yml)
R2_ENDPOINT=http://localhost:9000
R2_BUCKET=ozzy-content
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_REGION=us-east-1

# GitHub App (optional — enables private repo access via push)
# Create at https://github.com/settings/apps
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Secrets encryption (generate with: openssl rand -hex 32)
# Required for project secrets feature
# SECRETS_ENCRYPTION_KEY=0123456789abcdef...

# Limits
MAX_UPLOAD_SIZE_BYTES=104857600

# Docker compute provider (local container execution)
# DOCKER_COMPUTE_ENABLED=true
# DOCKER_COMPUTE_RUNTIME=runsc
# DOCKER_COMPUTE_MEMORY_LIMIT=2g
# DOCKER_COMPUTE_CPU_LIMIT=1

# Global compute settings
# COMPUTE_TIMEOUT_SECS=300
# COMPUTE_DEFAULT_PROVIDER=docker

# Fly Machines compute provider (remote execution)
# FLY_API_TOKEN=your_fly_token
# FLY_APP_NAME=ozzydb-compute
# FLY_REGION=fra

# Logging
RUST_LOG=debug,ozzy_server=trace,sqlx=warn
