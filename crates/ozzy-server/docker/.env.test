# Test environment variables (for CI/automated tests)
# These match docker-compose.yml defaults exactly

DATABASE_URL=postgres://ozzy:ozzy_dev_password@localhost:5432/ozzy
BIND_ADDRESS=0.0.0.0:3000
BASE_URL=http://localhost:3000

# Test GitHub OAuth (mock values - tests should mock OAuth)
GITHUB_CLIENT_ID=test_client_id
GITHUB_CLIENT_SECRET=test_client_secret

# MinIO
R2_ENDPOINT=http://localhost:9000
R2_BUCKET=ozzy-content
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_REGION=us-east-1

MAX_TAR_SIZE_BYTES=1073741824
MAX_UPLOAD_SIZE_BYTES=104857600

RUST_LOG=warn,ozzy_server=info
