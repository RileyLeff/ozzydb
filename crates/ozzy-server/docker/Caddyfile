# Caddy reverse proxy configuration for ozzy-server
# Automatically handles HTTPS certificates via Let's Encrypt

# API server
{$API_DOMAIN} {
    # Reverse proxy to ozzy-server
    reverse_proxy server:3000 {
        # Health checks
        health_uri /health
        health_interval 30s
        health_timeout 10s

        # Headers
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Request size limit (matches server's MAX_UPLOAD_SIZE_BYTES)
    request_body {
        max_size 100MB
    }

    # Logging
    log {
        output stdout
        format json
        level INFO
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Enable compression
    encode gzip zstd
}

# Frontend (SPA)
{$FRONTEND_DOMAIN} {
    root * /srv/frontend

    # SPA fallback: try the requested file, then fall back to index.html
    try_files {path} /index.html

    file_server

    # Logging
    log {
        output stdout
        format json
        level INFO
    }

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Cache immutable assets aggressively
    @immutable path /_app/immutable/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    # Enable compression
    encode gzip zstd
}
