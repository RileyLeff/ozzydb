# OzzyDB Production Environment
# Copy to .env.prod and fill in real values
# NEVER commit .env.prod to version control!

# ── Domains ──────────────────────────────────────────────
API_DOMAIN=api.ozzydb.com
FRONTEND_DOMAIN=ozzydb.com

# ── Database ─────────────────────────────────────────────
POSTGRES_USER=ozzy
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ozzy
DB_MAX_CONNECTIONS=10

# ── Server ───────────────────────────────────────────────
BASE_URL=https://api.ozzydb.com
RUST_LOG=info,ozzy_server=debug
CORS_ORIGINS=*

# ── GitHub OAuth ─────────────────────────────────────────
# Create at https://github.com/settings/developers
# Enable "Device Flow" in the OAuth app settings
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# Registration allowlist (comma-separated GitHub usernames)
# Leave empty to allow all users
ALLOWED_LOGINS=rileyleff

# ── GitHub App (optional — enables private repo access) ──
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# ── Secrets encryption ───────────────────────────────────
# Generate with: openssl rand -hex 32
# Required for project secrets feature
# SECRETS_ENCRYPTION_KEY=

# ── Cloudflare R2 Storage ────────────────────────────────
# Create bucket and a scoped API token (Object Read & Write)
# See planning/v3/riley_setup.md for step-by-step instructions
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=your_bucket_name
R2_ACCESS_KEY_ID=<your access key>
R2_SECRET_ACCESS_KEY=<your secret key>
R2_REGION=auto

# ── Fly.io Compute ───────────────────────────────────────
# Create app: fly apps create --machines --name ozzydb-compute
# Create token: fly tokens create deploy -a ozzydb-compute --name "ozzydb-server" --expiry 8760h
# See planning/v3/riley_setup.md for step-by-step instructions
FLY_API_TOKEN=fly_<your token>
FLY_APP_NAME=ozzydb-compute
FLY_REGION=fra

# ── Compute settings ─────────────────────────────────────
COMPUTE_TIMEOUT_SECS=300

# ── Limits ───────────────────────────────────────────────
MAX_TAR_SIZE_BYTES=1073741824
MAX_UPLOAD_SIZE_BYTES=104857600
